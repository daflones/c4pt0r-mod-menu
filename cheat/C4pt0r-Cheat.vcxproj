<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================ -->
  <!--  C4pt0r Cheats — Cheat DLL (Dynamic Library)                 -->
  <!--  Includes ImGui source from deps/imgui/                      -->
  <!-- ============================================================ -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-2222-4000-A000-000000000002}</ProjectGuid>
    <RootNamespace>C4pt0rCheat</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)build\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <TargetName>C4pt0r-Cheat</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)deps\imgui;$(ProjectDir)deps\imgui\backends;$(ProjectDir)deps\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NDEBUG;_CRT_SECURE_NO_WARNINGS;_WINDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>false</SDLCheck>
      <WarningLevel>Level3</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;psapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ==================== Source Files ==================== -->
  <ItemGroup>
    <!-- Core cheat -->
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="natives.cpp" />
    <ClCompile Include="hooks.cpp" />
    <ClCompile Include="menu.cpp" />
    <ClCompile Include="features.cpp" />
    <ClCompile Include="lua_exec.cpp" />

    <!-- Dear ImGui core -->
    <ClCompile Include="deps\imgui\imgui.cpp" />
    <ClCompile Include="deps\imgui\imgui_draw.cpp" />
    <ClCompile Include="deps\imgui\imgui_tables.cpp" />
    <ClCompile Include="deps\imgui\imgui_widgets.cpp" />

    <!-- Dear ImGui backends -->
    <ClCompile Include="deps\imgui\backends\imgui_impl_dx11.cpp" />
    <ClCompile Include="deps\imgui\backends\imgui_impl_win32.cpp" />

    <!-- MinHook (compiled as C) -->
    <ClCompile Include="deps\minhook\src\hook.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="deps\minhook\src\buffer.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="deps\minhook\src\trampoline.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="deps\minhook\src\hde\hde32.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="deps\minhook\src\hde\hde64.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
  </ItemGroup>

  <!-- ==================== Header Files ==================== -->
  <ItemGroup>
    <ClInclude Include="globals.h" />
    <ClInclude Include="memory.h" />
    <ClInclude Include="natives.h" />
    <ClInclude Include="hooks.h" />
    <ClInclude Include="menu.h" />
    <ClInclude Include="features.h" />
    <ClInclude Include="lua_exec.h" />
    <ClInclude Include="logger.h" />

    <!-- MinHook -->
    <ClInclude Include="deps\minhook\include\MinHook.h" />

    <!-- ImGui headers -->
    <ClInclude Include="deps\imgui\imgui.h" />
    <ClInclude Include="deps\imgui\imgui_internal.h" />
    <ClInclude Include="deps\imgui\imconfig.h" />
    <ClInclude Include="deps\imgui\backends\imgui_impl_dx11.h" />
    <ClInclude Include="deps\imgui\backends\imgui_impl_win32.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

</Project>
